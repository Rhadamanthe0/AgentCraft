# Modeles du banc CI, par usage (bot/model-chain.js). Aucun secret ici : les
# cles viennent des secrets GitHub (PLANNER_API_KEY, OPENCODE_SECONDARY_API_KEY),
# jamais d un fichier.
#
# UN modele par usage, AUCUN repli vers un autre modele (demande du
# proprietaire, 2026-09-26) : une panne du fournisseur remonte telle quelle.
PLANNER_BASE_URL=https://opencode.ai/zen/go/v1
# Cle essayee d abord : primary (PLANNER_API_KEY) ou secondary
# (OPENCODE_SECONDARY_API_KEY, second espace OpenCode). Un refus de cle (quota
# 429, 401/402/403) rejoue le MEME modele avec l autre cle ; seul repli admis.
# Repli valide au banc (6cea0f6 : 32/32 bots passes de primary, en quota
# hebdomadaire epuise, a secondary) : secondary d abord (choix du proprietaire).
PLANNER_KEY_FIRST=secondary

# Defaut (prechauffage, usage sans variable propre).
PLANNER_MODEL=deepseek-v4.1-flash

# ---- Cinq usages x (modele, effort de raisonnement) --------------------
# PLANNER_MODEL_<USAGE>, PLANNER_REASONING_EFFORT_<USAGE> (minimal / low /
# medium / high ; vide = defaut du modele), PLANNER_TIMEOUT_MS_<USAGE>
# optionnel (vide = PLANNER_TIMEOUT_MS du compose, 20 s).

# Actions (plans de mission, le gros des appels). deepseek-v4.1-flash ou
# mimo-v2.6-flash : comparaison par la sonde (report.modelProbe).
PLANNER_MODEL_PLAN=deepseek-v4.1-flash
PLANNER_REASONING_EFFORT_PLAN=low

# Chat du joueur (comprendre un message : ordre, precision, question, stop).
PLANNER_MODEL_CHAT=deepseek-v4.1-flash
PLANNER_REASONING_EFFORT_CHAT=low

# Reflexion : lecture de l objectif, une fois par mission. Muse Spark 1.3
# (indice Artificial Analysis 45-48), effort high, 60 s au plus (le banc laisse
# 75 s avant « aucune mission lancee », trees.START_TIMEOUT_S).
PLANNER_MODEL_BRIEF=muse-spark-1.3-contributor
PLANNER_REASONING_EFFORT_BRIEF=high
PLANNER_TIMEOUT_MS_BRIEF=60000

# Generation de la memoire (resume du fil de mission), rare.
PLANNER_MODEL_COMPACT=muse-spark-1.3-contributor
PLANNER_REASONING_EFFORT_COMPACT=high
PLANNER_TIMEOUT_MS_COMPACT=90000

# Demander de l aide / reviser les actions (bot/repair.js), bot deja bloque.
PLANNER_MODEL_REPAIR=muse-spark-1.3-contributor
PLANNER_REASONING_EFFORT_REPAIR=high
PLANNER_TIMEOUT_MS_REPAIR=90000

PLANNER_REASONING_EFFORT=

# Mesures qui ont guide ces choix (2026-09-26) : offres gratuites (Zen
# anonyme, Gemini, Groq, OpenRouter) limitees par minute/jour/IP, toutes en 429
# sous la charge du banc ; retirees du code (cles laissees dans GitHub).
# Les modeles servis a la cle secondaire sont listes dans report.json
# (`providerModels.go2`, cle secondaire) ; la sonde (report.modelProbe) compare les candidats.
