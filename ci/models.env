# Modeles du banc CI, par usage (bot/model-chain.js). Aucun secret ici : la
# cle vient d un secret GitHub (PLANNER_API_KEY dans le workflow), jamais d un
# fichier.
#
# UN modele par usage, AUCUN repli vers un autre modele (demande du
# proprietaire, 2026-09-26) : une panne du fournisseur remonte telle quelle.
PLANNER_BASE_URL=https://opencode.ai/zen/go/v1

# DEV (banc CI) : DeepSeek V4.1 Flash pour tous les usages (choix du
# proprietaire, 2026-10-11 : Haiku epuisait le plafond Go, 15 $/mois contre
# 60 $ pour DeepSeek). La PROD (compose.yaml) reste sur Claude Haiku 5.5.
# Mesure du 2026-10-09 (33 paires) : DeepSeek 27/33 contre 29/33 pour Haiku,
# duree mediane 334 s contre 189 s ; les plafonds de niveau excluent deja
# l attente du modele (trees.Plafond).
# Defaut (prechauffage, usage sans variable propre).
PLANNER_MODEL=deepseek-v4.1-flash

# ---- Cinq usages x (modele, effort de raisonnement) --------------------
# PLANNER_MODEL_<USAGE>, PLANNER_REASONING_EFFORT_<USAGE> (minimal / low /
# medium / high ; vide = defaut du modele), PLANNER_TIMEOUT_MS_<USAGE>
# optionnel (vide = PLANNER_TIMEOUT_MS du compose, 20 s).

# Actions (plans de mission, le gros des appels). deepseek-v4.1-flash ou
# mimo-v2.6-flash : comparaison par la sonde (report.modelProbe).
PLANNER_MODEL_PLAN=deepseek-v4.1-flash
PLANNER_REASONING_EFFORT_PLAN=low

# Chat du joueur (comprendre un message : ordre, precision, question, stop).
PLANNER_MODEL_CHAT=deepseek-v4.1-flash
PLANNER_REASONING_EFFORT_CHAT=low

# Reflexion : lecture de l objectif, une fois par mission. Effort low depuis
# le 2026-10-10 (choix du proprietaire, garde avec DeepSeek le 2026-10-11 :
# quota). Historique : DeepSeek V4.1 Flash effort high (2026-09-27, demande du proprietaire apres comparaison, sonde
# d intelligence du banc d1983b2) : 25/27 criteres contre 23/27 pour Muse high,
# mediane 4,2 s contre 20 s (Muse : p95 40-58 s et 2-3 delais de 60 s par banc,
# missions jamais lancees). 30 s au plus, rejouee une fois (mission.start) :
# 60 s < 75 s avant « aucune mission lancee » (trees.START_TIMEOUT_S).
PLANNER_MODEL_BRIEF=deepseek-v4.1-flash
PLANNER_REASONING_EFFORT_BRIEF=low
PLANNER_TIMEOUT_MS_BRIEF=30000
# Budget de sortie des modeles /responses (Muse ; raisonnement compris) :
# 4096 tronquait ~4 % des lectures d objectif en `high` (b91985a : 4 sur ~93,
# deux fois de suite sur route/under-far-tree => 3 min pour « Va sous
# l arbre », harness a 150 s). Plafond seulement : une reponse courte ne change pas.
PLANNER_PILOT_MAX_TOKENS=8192
PLANNER_PILOT_RETRY_MAX_TOKENS=16384

# Generation de la memoire (resume du fil de mission), rare. Meme modele que
# le reste, effort low.
PLANNER_MODEL_COMPACT=deepseek-v4.1-flash
PLANNER_REASONING_EFFORT_COMPACT=low
PLANNER_TIMEOUT_MS_COMPACT=90000


PLANNER_REASONING_EFFORT=

# Mesures qui ont guide ces choix (2026-09-26) : offres gratuites (Zen
# anonyme, Gemini, Groq, OpenRouter) limitees par minute/jour/IP, toutes en 429
# sous la charge du banc ; retirees du code, cles supprimees de GitHub
# (2026-10-04).
# Les modeles servis a la cle secondaire sont listes dans report.json
# (`providerModels.go2`, cle secondaire) ; la sonde (report.modelProbe) compare les candidats.
