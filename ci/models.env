# Modeles du banc CI, par usage (bot/model-chain.js). Aucun secret ici : les
# cles viennent des secrets GitHub (PLANNER_API_KEY, OPENCODE_SECONDARY_API_KEY,
# GROQ_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY), jamais d un fichier.
#
# UN modele par usage, AUCUN repli vers un autre modele (demande du
# proprietaire, 2026-09-26) : une panne du fournisseur remonte telle quelle.
# `modele@go2` = gateway Go avec la cle du second espace OpenCode ;
# `modele@https://...` = autre base, avec la seule cle propre a cet hote.
PLANNER_BASE_URL=https://opencode.ai/zen/go/v1

# Defaut (prechauffage, usage sans variable propre).
PLANNER_MODEL=deepseek-v4.1-flash@go2

# ---- Cinq usages x (modele, effort de raisonnement) --------------------
# PLANNER_MODEL_<USAGE>, PLANNER_REASONING_EFFORT_<USAGE> (minimal / low /
# medium / high ; vide = defaut du modele), PLANNER_TIMEOUT_MS_<USAGE>
# optionnel (vide = PLANNER_TIMEOUT_MS du compose, 20 s).

# Actions (plans de mission, le gros des appels). deepseek-v4.1-flash ou
# mimo-v2.6-flash : comparaison par la sonde (report.modelProbe).
PLANNER_MODEL_PLAN=deepseek-v4.1-flash@go2
PLANNER_REASONING_EFFORT_PLAN=low

# Chat du joueur (comprendre un message : ordre, precision, question, stop).
PLANNER_MODEL_CHAT=deepseek-v4.1-flash@go2
PLANNER_REASONING_EFFORT_CHAT=low

# Reflexion : lecture de l objectif, une fois par mission. Muse Spark 1.3
# (indice Artificial Analysis 45-48). Un niveau sans mission lancee a 45 s
# echoue : 40 s au plus.
PLANNER_MODEL_BRIEF=muse-spark-1.3-contributor@go2
PLANNER_REASONING_EFFORT_BRIEF=high
PLANNER_TIMEOUT_MS_BRIEF=40000

# Generation de la memoire (resume du fil de mission), rare.
PLANNER_MODEL_COMPACT=muse-spark-1.3-contributor@go2
PLANNER_REASONING_EFFORT_COMPACT=high
PLANNER_TIMEOUT_MS_COMPACT=90000

# Demander de l aide / reviser les actions (bot/repair.js), bot deja bloque.
PLANNER_MODEL_REPAIR=muse-spark-1.3-contributor@go2
PLANNER_REASONING_EFFORT_REPAIR=high
PLANNER_TIMEOUT_MS_REPAIR=90000

PLANNER_REASONING_EFFORT=

# Mesures qui ont guide ces choix (2026-09-26) :
# - space-bunny-free (Zen anonyme) : `reasoning_effort: low` ~2-3 s au lieu de
#   4-10 s ; limite par IP (le runner a fini en 429 toute la soiree).
# - Gemini 3.5 Flash-Lite ~1,2 s par plan, quota quotidien vite epuise ; Groq
#   gratuit 8000 jetons/min par modele (~2 plans/min, sans cache).
# - Offres gratuites refusees hors client OpenCode (403 FreeTierError) : ne
#   pas contourner.
# Bases OpenAI-compatibles a cle (bot/model-chain.js PROVIDER_KEYS) :
#   <modele>@https://api.groq.com/openai/v1               (GROQ_API_KEY)
#   <modele>@https://generativelanguage.googleapis.com/v1beta/openai (GEMINI_API_KEY)
#   <modele>:free@https://openrouter.ai/api/v1            (OPENROUTER_API_KEY)
# Les modeles servis sont listes dans report.json (`providerModels`).
