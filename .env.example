# Copier ce fichier en ".env" puis y mettre ta vraie cle.
# docker compose lit automatiquement le fichier .env de ce dossier.
#
# Le cerveau est le planificateur JSON distant (gateway OpenCode Go). La cle
# `opencode-go` se met ci-dessous dans PLANNER_API_KEY ; sans elle les appels
# echouent en 401.
#
# Jev (TypeSafe) n est plus le pilote : il ne reprend la main que si
# PLANNER_BASE_URL est vide. Sa cle ne sert donc qu en repli.
TYPESAFE_API_KEY=
# `jev` : Jev choisit l action de chaque tour de mission (une action par appel,
# ampleur par un second appel). Chat, brief, aide et reflexion restent au
# planificateur JSON ; un echec de Jev rend le tour au planificateur.
ACTION_CHOOSER=planner
# Qui repond aux questions de Jev : zen (defaut avec PLANNER_BASE_URL : meme
# gateway, cle et en-tetes que le planificateur) ou typesafe (TYPESAFE_API_KEY).
JEV_PROVIDER=
# Modele Zen de Jev. Vide : un modele dont l id contient « jev » sur /models
# s il repond, sinon deepseek-v4.1-flash sans raisonnement (max_tokens 300).
JEV_ZEN_MODEL=

# Optionnels
JEV_MODEL=jev-latest
# Confiance minimale pour qu un message de chat declenche une commande.
JEV_MIN_CONFIDENCE=0.6
# Probabilite minimale de "objectif accompli" pour clore une mission.
JEV_DONE_THRESHOLD=0.75

# Garde-fous de la boucle de mission : elle s arrete au premier atteint.
MISSION_MAX_STEPS=90
MISSION_MAX_DURATION_MS=900000
# Quantite visee quand l objectif ne precise pas de nombre.
MISSION_DEFAULT_QUOTA=16

# ---------------------------------------------------------------------------
# Mini-carte PNG jointe au planificateur (vision)
#
# DESACTIVEE par defaut : sans MISSION_SCREENSHOT=1, aucun pixel n est genere et
# l etat envoye au planificateur est strictement celui d avant. Activee, une
# capture est jointe au message UTILISATEUR (jamais au prompt systeme, donc le
# cache de prefixe reste intact) toutes MISSION_SCREENSHOT_EVERY etapes, sur un
# carre de MISSION_SCREENSHOT_RAYON blocs de demi-cote. L image coute des jetons
# d entree a chaque envoi : le cooldown en etapes est la pour ca. Elle est
# produite sans dependance par bot/screenshot.js (~3-10 ms en 33x33).
# Le modele retenu (deepseek-v4.1-flash) percoit les images ; l orientation
# absolue de la carte n est pas fiable, le prompt demande de raisonner en
# disposition relative au centre.
# ---------------------------------------------------------------------------
MISSION_SCREENSHOT=
MISSION_SCREENSHOT_EVERY=5
MISSION_SCREENSHOT_RAYON=16

# Le mode de jeu est fixe par le serveur (MODE dans compose.yaml, en survie) :
# le bot n a plus aucun pouvoir d administration et ne peut pas se l imposer.

# ---------------------------------------------------------------------------
# Planificateur JSON distant (defaut depuis 2026-09-22)
#
# Un modele distant, servi par le gateway OpenCode Go, rend un plan de plusieurs
# actions par appel, la ou Jev rendait une action par appel (voire deux appels).
# Protocole OpenAI /chat/completions. Plus de service ni de modele local : le
# chat et l etat de jeu sont envoyes a opencode.ai pour chaque appel.
#
# Zen exige un user-agent identifiable et un en-tete x-opencode-session STABLE
# par conversation : c est lui qui optimise le routage et le cache de prompt.
# PLANNER_SESSION_ID est derive du pseudo du bot pour survivre aux redemarrages.
#
# Vider PLANNER_BASE_URL pour revenir integralement a Jev.
# ---------------------------------------------------------------------------
PLANNER_BASE_URL=https://opencode.ai/zen/go/v1
# deepseek-v4.1-flash : modele a raisonnement. Il lui faut de la marge de sortie
# (PLANNER_MAX_TOKENS) ; trop basse, il raisonne jusqu'au bout et rend un contenu
# vide (finish=length).
# Ne mettre ici qu'un modele servi sur /chat/completions : le gateway Go en
# expose d'autres sur /responses (muse-spark -> 503) et /messages. C'est la
# seule limite d'endpoint : deepseek-v4.1-flash percoit aussi les images
# (verifie), donc la capture jointe (MISSION_SCREENSHOT ci-dessus) passe sans
# changer de modele. deepseek-v4-flash-vision-exp reste une alternative dediee.
# Verifier la liste : GET /zen/go/v1/models.
PLANNER_MODEL=deepseek-v4.1-flash
# Explicit activation; legacy retains the earlier single-model profile.
PLANNER_ROUTING_MODE=legacy
PLANNER_FAST_MODEL=mimo-v2.6-flash
PLANNER_FAST_TIMEOUT_MS=45000
PLANNER_FAST_MAX_TOKENS=4096
PLANNER_STRATEGY_MODEL=muse-spark-1.3-contributor
PLANNER_STRATEGY_TIMEOUT_MS=120000
PLANNER_STRATEGY_MAX_TOKENS=16384
# Cle `opencode-go`, a recuperer aupres du gateway OpenCode Go.
PLANNER_API_KEY=
PLANNER_SESSION_ID=minecraft-bot-TestBot
PLANNER_USER_AGENT=minecraft-bot/1.0
# Nombre maximal d actions dans un plan. Plus haut = moins d appels, mais un
# plan long part plus souvent a la poubelle au premier echec.
PLANNER_PLAN_MAX=5
# Delai d un appel une fois le modele chaud (le premier paie le prechauffage).
PLANNER_TIMEOUT_MS=12000
# Marge de sortie : le raisonnement de deepseek compte dans max_tokens.
PLANNER_MAX_TOKENS=2000
# 1 = trace chaque plan recu et chaque reponse rejetee.
PLANNER_DEBUG=

# ---------------------------------------------------------------------------
# Auto-reparation (demander_aide / reviser_actions)
#
# Meme gateway que le planificateur. Sans REPAIR_API_KEY, le module est inactif
# et `demander_aide` echoue proprement : la mission continue.
# ---------------------------------------------------------------------------
REPAIR_BASE_URL=https://opencode.ai/zen/go/v1
# deepseek v4.1 pour tout : le reparateur utilise le meme modele que le planificateur.
REPAIR_MODEL=deepseek-v4.1-flash
REPAIR_API_KEY=
REPAIR_SESSION_ID=minecraft-bot-repair-TestBot
REPAIR_USER_AGENT=minecraft-bot/1.0
# Plafonds par mission, pour ne pas boucler sur une API distante.
REPAIR_MAX_PER_MISSION=2
REPAIR_MAX_REVISIONS=2

# Pause entre deux etapes deja planifiees (aucun appel a amortir).
MISSION_QUEUE_TICK_MS=250
# Delai minimal entre deux messages systeme du bot (impasse signalee, action
# apprise/modifiee/supprimee). Ils echappent a la limite de l action "dire".
MISSION_ANNOUNCE_COOLDOWN_MS=5000
# Actions apprises : combien au maximum, et de combien d etapes chacune.
MACROS_MAX=24
MACROS_MAX_STEPS=8

# ---------------------------------------------------------------------------
# Memoire du planificateur (`memoriser` / `oublier`) — cache en couches
#
# Un plafond par portee, plus de budget total partage :
#   - long_terme : couche 3 du prompt systeme (mise en cache), ecrite sur
#     disque UNE seule fois par mission, au finish ;
#   - travail : couche 4, le fil de la mission en cours, en ajout seul. Au-dela
#     de MEMORY_WORK_COMPACT_AT jetons, il est compacte par un resume du modele
#     vers MEMORY_WORK_COMPACT_TO (une invalidation de cache payee une fois).
# Les notes long terme ecrites en cours de mission sont tamponnees (visibles
# sous `a_retenir`) jusqu au commit de fin de mission. Une ecriture qui
# depasserait son plafond est refusee. C est un plafond de memoire du bot, pas
# la fenetre du modele distant ; le prompt systeme et les statistiques s y
# ajoutent au moment de l appel.
# ---------------------------------------------------------------------------
MEMORY_LONG_TERM_TOKENS=10000
MEMORY_WORK_TOKENS=10000
MEMORY_WORK_COMPACT_AT=8000
MEMORY_WORK_COMPACT_TO=4000
# Taille maximale d une note isolee, en caracteres.
MEMORY_NOTE_MAX=4000
